{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/app.ts",
      "rewrites": [
        {
          "source": "/_/backend/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "framework": "express",
      "buildCommand": "npm run typecheck",
      "installCommand": "npm ci"
    }
  },
  "rewrites": [
    {
      "source": "/_/backend/:path(.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/_/backend/api/notifications/overdue-tasks/run",
      "schedule": "0 6 * * *"
    }
  ]
}
